# Veyro S3 build configuration.
#
# The committed sdkconfig.esp32s3_watch was generated by an early build with
# Bluetooth off and 2 MB of flash, so veyro_main.c could not even find the
# NimBLE headers and the partition table did not fit the 16 MB part. These are
# the settings the source actually requires; sdkconfig is generated from this
# file, and the generated file is not committed.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# veyro_main.c uses NimBLE directly (nimble_port.h, ble_hs.h, ble_gap.h).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120

# partitions.csv reserves two OTA slots plus a 3.8 MB storage partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
